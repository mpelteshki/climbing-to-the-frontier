/-- A finite residue certificate, checked using the proved CRT criterion. -/
def Valid (ms : List Nat) (rs : List Int) : Prop :=
  rs.length = ms.length ∧ ∀ i j : Fin ms.length, i ≠ j →
    ¬ (Nat.gcd ms[i] ms[j] : Int) ∣ rs[j.val]! - rs[i.val]!
instance (ms : List Nat) (rs : List Int) : Decidable (Valid ms rs) := inferInstanceAs
  (Decidable (rs.length = ms.length ∧ ∀ i j : Fin ms.length, i ≠ j →
    ¬ (Nat.gcd ms[i] ms[j] : Int) ∣ rs[j.val]! - rs[i.val]!))
theorem valid_disjoint {ms : List Nat} {rs : List Int} (h : Valid ms rs) :
    DisjointClasses (fun i : Fin ms.length => rs[i.val]!) (fun i => ms[i]) := by
  intro i j hij hmeet
  exact h.2 i j hij (gcd_dvd_of_meet _ _ _ _ hmeet)
