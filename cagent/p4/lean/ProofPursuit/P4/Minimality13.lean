theorem witnesses_valid : witnesses.all (fun w => decide (Valid w.1 w.2)) = true := by decide
theorem covers : (DensityAudit13.sublists DensityAudit13.candidate).all
    (fun ms => ms.length > 6 || witnesses.any (fun w => w.1 == ms)) = true := by decide
theorem every_small_sublist_admissible (ms : List Nat)
    (hs : ms.Sublist DensityAudit13.candidate) (hl : ms.length ≤ 6) :
    ∃ a : Fin ms.length → Int, DisjointClasses a (fun i => ms[i]) := by
  have hc := List.all_eq_true.mp covers ms (DensityAudit13.mem_sublists hs)
  simp only [Bool.or_eq_true, decide_eq_true_eq, List.any_eq_true] at hc
  rcases hc with hbig | ⟨w, hw, he⟩
  · omega
  · have heq : w.1 = ms := by simpa using he
    have hv := List.all_eq_true.mp witnesses_valid w hw
    have hv' : Valid w.1 w.2 := of_decide_eq_true hv
    rw [heq] at hv'
    exact ⟨_, valid_disjoint hv'⟩
#print axioms every_small_sublist_admissible
