import ProofPursuit.P4.ElevenCheck

namespace ProofPursuit.P4.ElevenCertificate

open ElevenCheck

/-- A mask selects positions, so repeated moduli remain separate entries. -/
def select : Nat → List Nat → List Nat
  | _, [] => []
  | mask, x :: xs =>
      if mask % 2 == 1 then x :: select (mask / 2) xs
      else select (mask / 2) xs

theorem select_sublist (mask : Nat) (xs : List Nat) :
    (select mask xs).Sublist xs := by
  induction xs generalizing mask with
  | nil => simp [select]
  | cons x xs ih =>
      simp only [select]
      split
      · exact (ih (mask / 2)).cons_cons x
      · exact (ih (mask / 2)).cons x

private def selectedModuli (mask : Nat) (pre : List Nat) : List Nat :=
  (select mask pre).map modulus

/-- The admissible next ranks: anchor-first, nondecreasing, and pairwise gcd
between 2 and 10 against every existing entry. -/
def allowed (pre : List Nat) : List Nat :=
  ranks.filter fun x =>
    (if pre.length < 3 then x < 18 else true) &&
      pre.all (fun y =>
        decide (y ≤ x ∧ 1 < Nat.gcd (modulus y) (modulus x) ∧
          Nat.gcd (modulus y) (modulus x) < 11))

/-- The density property needed at every prefix, for every selected position
subset and every positive common multiple of its pairwise gcds. -/
def ValidPrefix (pre : List Nat) : Prop :=
  ∀ (mask M : Nat), 0 < M →
    (selectedModuli mask pre).Pairwise (fun x y => Nat.gcd x y ∣ M) →
      ((selectedModuli mask pre).map
        (fun x => M / Nat.gcd x M)).sum ≤ M

private def densityBad (pre : List Nat) (mask M : Nat) : Bool :=
  let ys := selectedModuli mask pre
  decide (0 < M) &&
    decide (ys.Pairwise (fun x y => Nat.gcd x y ∣ M)) &&
      decide (M < (ys.map (fun x => M / Nat.gcd x M)).sum)

private theorem densityBad_false_of_valid (pre : List Nat)
    (hvalid : ValidPrefix pre) (mask M : Nat) :
    densityBad pre mask M = false := by
  cases h : densityBad pre mask M with
  | false => rfl
  | true =>
      have hfacts : 0 < M ∧
          (selectedModuli mask pre).Pairwise (fun x y => Nat.gcd x y ∣ M) ∧
          M < ((selectedModuli mask pre).map
            (fun x => M / Nat.gcd x M)).sum := by
        simpa [densityBad, Bool.and_eq_true, and_assoc] using h
      have hle := hvalid mask M hfacts.1 hfacts.2.1
      omega

/-- Density leaves carry one selected-position mask and a positive modulus.
Branches store one child per value in `allowed pre`, in that exact order. -/
inductive Cert where
  | density (mask M : Nat)
  | branch (children : List Cert)

private def childrenOK (f : Nat → Cert → Bool) : List Nat → List Cert → Bool
  | [], [] => true
  | x :: xs, c :: cs => f x c && childrenOK f xs cs
  | _, _ => false

private theorem child_of_childrenOK (f : Nat → Cert → Bool)
    (xs : List Nat) (cs : List Cert)
    (h : childrenOK f xs cs = true) :
    ∀ x ∈ xs, ∃ c, f x c = true := by
  induction xs generalizing cs with
  | nil => intro x hx; cases hx
  | cons y ys ih =>
      cases cs with
      | nil => simp [childrenOK] at h
      | cons c cs =>
          simp only [childrenOK, Bool.and_eq_true] at h
          obtain ⟨hfirst, hrest⟩ := h
          intro x hx
          rcases List.mem_cons.mp hx with rfl | hx
          · exact ⟨c, hfirst⟩
          · exact ih cs hrest x hx

/-- Kernel-reducible local checker for the proof-carrying search tree. -/
def check : Nat → List Nat → Cert → Bool
  | _, pre, .density mask M => densityBad pre mask M
  | 0, _, .branch _ => false
  | remaining + 1, pre, .branch children =>
      childrenOK (fun x c => check remaining (pre ++ [x]) c)
        (allowed pre) children

/-- A candidate path satisfies all semantic density conditions at each prefix.
The ordering, anchor, domain, and pair conditions are in `allowed`. -/
def Candidate (pre : List Nat) : Nat → List Nat → Prop
  | 0, [] => ValidPrefix pre
  | 0, _ :: _ => False
  | _ + 1, [] => False
  | remaining + 1, x :: xs =>
      ValidPrefix pre ∧ x ∈ allowed pre ∧
        Candidate (pre ++ [x]) remaining xs

theorem check_sound (remaining : Nat) (pre : List Nat) (cert : Cert)
    (hcheck : check remaining pre cert = true) :
    ∀ xs, Candidate pre remaining xs → False := by
  induction remaining generalizing pre cert with
  | zero =>
      cases cert with
      | density mask M =>
          intro xs hcandidate
          cases xs with
          | nil =>
              have hfalse := densityBad_false_of_valid pre hcandidate mask M
              simp [check, hfalse] at hcheck
          | cons x xs => cases hcandidate
      | branch children => simp [check] at hcheck
  | succ n ih =>
      cases cert with
      | density mask M =>
          intro xs hcandidate
          cases xs with
          | nil => cases hcandidate
          | cons x xs =>
              have hfalse := densityBad_false_of_valid pre hcandidate.1 mask M
              simp [check, hfalse] at hcheck
      | branch children =>
          intro xs hcandidate
          cases xs with
          | nil => cases hcandidate
          | cons x rest =>
              obtain ⟨_, hx, hrest⟩ := hcandidate
              obtain ⟨child, hchild⟩ :=
                child_of_childrenOK
                  (fun y c => check n (pre ++ [y]) c)
                  (allowed pre) children hcheck x hx
              exact ih (pre ++ [x]) child hchild rest hrest

