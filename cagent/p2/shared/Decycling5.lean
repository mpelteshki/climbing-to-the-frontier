def cycleValid (d : Nat) (c : List Nat) : Bool :=
  decide c.Nodup && decide (3 ≤ c.length) &&
  c.all (fun v => decide (v < 2 ^ d)) &&
  (c.zip (c.drop 1 ++ c.take 1)).all (fun (u, v) => Hypercube.adjacent d u v)

theorem shortCycles_valid : ∀ c ∈ shortCycles, cycleValid 5 c = true := by
  have h : shortCycles.all (cycleValid 5) = true := by decide
  intro c hc
  exact (List.all_eq_true.mp h) c hc

theorem shortCycles_edge_rich : ∀ c ∈ shortCycles,
    c.Nodup ∧ c ≠ [] ∧ c.length ≤ Hypercube.edgeCount 5 c := by decide

theorem shortCycles_subset_range : ∀ c ∈ shortCycles,
    c ⊆ List.range 32 := by decide

def hit (selected cycle : List Nat) : Bool := cycle.any selected.contains

def internalEdges (selected : List Nat) : Nat :=
  edgePairs.countP (fun (u, v) => selected.contains u && selected.contains v)

def shortCyclesHit (selected : List Nat) : Bool :=
  shortCycles.all (hit selected)

def pickUnhit (selected : List Nat) : Option (List Nat) :=
  shortCycles.find? (fun cycle => !hit selected cycle)

def search : Nat → List Nat → Bool
  | 0, selected => 3 < internalEdges selected || (pickUnhit selected).isSome
  | fuel + 1, selected =>
      if 3 < internalEdges selected then true
      else match pickUnhit selected with
      | none => false
      | some cycle => cycle.all (fun v => search fuel (v :: selected))

private theorem hit_iff (selected cycle : List Nat) :
    hit selected cycle = true ↔ ∃ v, v ∈ cycle ∧ v ∈ selected := by
  simp [hit, List.any_eq_true]

private theorem countP_mono {α : Type} (xs : List α) (p q : α → Bool)
    (h : ∀ x ∈ xs, p x = true → q x = true) :
    xs.countP p ≤ xs.countP q := by
  induction xs with
  | nil => simp
  | cons x rest ih =>
    have hr : ∀ y ∈ rest, p y = true → q y = true := by
      intro y hy
      exact h y (by simp [hy])
    have htail := ih hr
    simp only [List.countP_cons]
    cases hp : p x with
    | false =>
      cases hq : q x <;> simp <;> omega
    | true =>
      have hq : q x = true := h x (by simp) hp
      simp [hq]
      omega

private theorem internalEdges_mono {selected target : List Nat}
    (hsub : selected ⊆ target) :
    internalEdges selected ≤ internalEdges target := by
  unfold internalEdges
  apply countP_mono
  intro ⟨u, v⟩ _ hp
  simp only [Bool.and_eq_true, List.contains_iff_mem] at hp ⊢
  exact ⟨hsub hp.1, hsub hp.2⟩

private theorem unhit_cycle_vertex (selected target cycle : List Nat)
    (hfind : pickUnhit selected = some cycle)
    (hhit : shortCyclesHit target = true) :
    ∃ v, v ∈ cycle ∧ v ∈ target ∧ v ∉ selected := by
  have hc : cycle ∈ shortCycles :=
    List.mem_of_find?_eq_some (by simpa [pickUnhit] using hfind)
  have hnot : hit selected cycle = false := by
    have h := List.find?_some (by simpa [pickUnhit] using hfind)
    simpa using h
  have hyes : hit target cycle = true :=
    (List.all_eq_true.mp hhit) cycle hc
  obtain ⟨v, hvcycle, hvtarget⟩ := (hit_iff target cycle).mp hyes
  refine ⟨v, hvcycle, hvtarget, ?_⟩
  intro hvselected
  have := (hit_iff selected cycle).mpr ⟨v, hvcycle, hvselected⟩
  simp [this] at hnot

private theorem search_sound (fuel : Nat) (selected : List Nat)
    (hsearch : search fuel selected = true) :
    ∀ target : List Nat, target.Nodup → selected.Nodup → selected ⊆ target →
      target.length ≤ selected.length + fuel →
      internalEdges target ≤ 3 → shortCyclesHit target = true → False := by
  induction fuel generalizing selected with
  | zero =>
    intro target ht hs hsub hlen hedge hhit
    have hmono := internalEdges_mono hsub
    simp only [search, Bool.or_eq_true] at hsearch
    rcases hsearch with hlarge | hsome
    · have : 3 < internalEdges selected := by simpa using hlarge
      omega
    · cases hfind : pickUnhit selected with
      | none => simp [hfind] at hsome
      | some cycle =>
        obtain ⟨v, _, hvt, hvnot⟩ := unhit_cycle_vertex selected target cycle hfind hhit
        have hsub' : v :: selected ⊆ target := by
          intro x hx
          rcases List.mem_cons.mp hx with rfl | hx
          · exact hvt
          · exact hsub hx
        have hnodup : (v :: selected).Nodup :=
          List.nodup_cons.mpr ⟨hvnot, hs⟩
        have hstrict := List.Nodup.length_le_of_subset hnodup hsub'
        simp only [List.length_cons] at hstrict
        omega
  | succ fuel ih =>
    intro target ht hs hsub hlen hedge hhit
    have hmono := internalEdges_mono hsub
    simp only [search] at hsearch
    by_cases hlarge : 3 < internalEdges selected
    · omega
    · simp only [hlarge, ↓reduceIte] at hsearch
      cases hfind : pickUnhit selected with
      | none => simp [hfind] at hsearch
      | some cycle =>
        simp only [hfind] at hsearch
        obtain ⟨v, hvc, hvt, hvnot⟩ :=
          unhit_cycle_vertex selected target cycle hfind hhit
        have hchild : search fuel (v :: selected) = true :=
          (List.all_eq_true.mp hsearch) v hvc
        have hsub' : v :: selected ⊆ target := by
          intro x hx
          rcases List.mem_cons.mp hx with rfl | hx
          · exact hvt
          · exact hsub hx
        have hnodup : (v :: selected).Nodup :=
          List.nodup_cons.mpr ⟨hvnot, hs⟩
        apply ih (v :: selected) hchild target ht hnodup hsub'
        · simp only [List.length_cons]
          omega
        · exact hedge
        · exact hhit

theorem no_thirteen_of_search (hcheck : search 13 [] = true)
    (bad : List Nat) (hn : bad.Nodup) (hlen : bad.length ≤ 13)
    (hedge : internalEdges bad ≤ 3) (hhit : shortCyclesHit bad = true) : False :=
  search_sound 13 [] hcheck bad hn (by simp) (by simp)
    (by simpa using hlen) hedge hhit


